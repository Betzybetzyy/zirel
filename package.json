{
  "name": "zirel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "dotenv -e .env -- tsx scripts/seed.ts",
    "db:create-admin": "dotenv -e .env -- tsx scripts/create-admin.ts",
    "db:migrate:create": "dotenv -e .env -e .env.docker -- prisma migrate dev --name init",
    "db:migrate:docker": "dotenv -e .env -e .env.docker -- prisma migrate deploy",
    "db:seed:docker": "dotenv -e .env -e .env.docker -- tsx scripts/seed.ts --skip-upload",
    "db:setup:docker": "npm run db:migrate:docker && npm run db:seed:docker"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.12.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "zeptomatch": "1.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
