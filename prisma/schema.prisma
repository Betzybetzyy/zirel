// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {                                                                                                                                                                                         
    provider        = "prisma-client-js"                                                                                                                                                                     
} 

datasource db {
  provider = "postgresql"
}

// ============================================
// CATEGORÍAS (Anillos, Aros, Pulseras, Collares)
// ============================================
model Category {
  id          String    @id @default(cuid())
  name        String    @unique          // "Anillos"
  slug        String    @unique          // "anillos"
  description String?
  order       Int       @default(0)      // Para ordenarlas en el menú

  products    Product[]                  // Relación: una categoría tiene muchos productos

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

// ============================================
// PRODUCTOS (las joyas)
// ============================================
model Product {
  id          String    @id @default(cuid())
  sku         String    @unique          // "ANI-001"
  slug        String    @unique          // "anillo-triple-circon"
  name        String                     // "Anillo Triple Circón"
  description String                     // Descripción larga
  price       Int                        // En pesos chilenos (sin decimales)
  size        String?                    // "Talla 19", "20mm diámetro", etc
  material    String    @default("Plata 925")
  stock       Int       @default(0)
  active      Boolean   @default(true)   // Para ocultar sin borrar
  featured    Boolean   @default(false)  // Para mostrar en home

  // Relación con categoría
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])

  // Relación con imágenes
  images      ProductImage[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("products")
  @@index([categoryId])
  @@index([active, featured])
}

// ============================================
// IMÁGENES (cada producto puede tener varias)
// ============================================
model ProductImage {
  id        String   @id @default(cuid())
  url       String                       // URL de Cloudinary
  alt       String?                      // Texto alternativo para SEO/accesibilidad
  order     Int      @default(0)         // Para ordenar las fotos del producto
  isPrimary Boolean  @default(false)     // La foto principal del catálogo

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("product_images")
  @@index([productId])
}

// ============================================
// PEDIDOS
// ============================================
model Order {
  id              String        @id @default(cuid())
  orderNumber     Int           @unique @default(autoincrement())  // 1, 2, 3... más amigable que el cuid

  // Datos del cliente
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String?
  customerComuna  String?
  customerNotes   String?

  // Totales
  subtotal        Int
  total           Int

  // Estado
  status          OrderStatus   @default(PENDIENTE)
  whatsappSent    Boolean       @default(false)

  // Items del pedido
  items           OrderItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
  @@index([status])
}

model OrderItem {
  id            String    @id @default(cuid())

  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId     String
  productSku    String                                    // Snapshot por si se borra el producto
  productName   String                                    // Snapshot
  productPrice  Int                                       // Snapshot del precio al momento de la compra
  quantity      Int

  createdAt     DateTime  @default(now())

  @@map("order_items")
  @@index([orderId])
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

// ============================================
// USUARIOS (solo admin por ahora)
// ============================================
enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ============================================
// CLIENTES (registro interno de compradores frecuentes)
// ============================================
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?

  sales     Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

// ============================================
// VENTAS (POS interno — admin registra ventas presenciales)
// ============================================
enum SaleStatus {
  PENDIENTE
  COMPLETADA
  ANULADA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CUOTAS
  ABONO
}

model Sale {
  id            String        @id @default(cuid())
  saleNumber    Int           @unique @default(autoincrement())

  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerName  String?       // Snapshot del nombre al momento de la venta
  customerNotes String?

  subtotal      Int
  total         Int           // = subtotal (sin IVA ni descuento)

  paymentMethod    PaymentMethod
  status           SaleStatus    @default(COMPLETADA)
  installmentCount Int?          // nº de cuotas pactadas (solo CUOTAS)

  items            SaleItem[]
  payments         SalePayment[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  annulledAt       DateTime?

  @@map("sales")
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model SaleItem {
  id           String   @id @default(cuid())

  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId    String                               // FK al producto (puede haberse borrado)
  productSku   String                               // Snapshot
  productName  String                               // Snapshot
  productPrice Int                                  // Precio al momento de la venta
  quantity     Int

  createdAt    DateTime @default(now())

  @@map("sale_items")
  @@index([saleId])
}

model SalePayment {
  id                Int           @id @default(autoincrement())
  saleId            String
  sale              Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount            Int
  method            PaymentMethod
  installmentNumber Int?
  note              String?
  createdAt         DateTime      @default(now())

  @@map("sale_payments")
  @@index([saleId])
}

// ============================================
// FEATURE FLAGS (control de funcionalidades)
// ============================================
model FeatureFlag {
  key         String   @id
  label       String   @default("")
  description String   @default("")
  enabled     Boolean
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}